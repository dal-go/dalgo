{
  "format": "tugql-execute-suite",
  "version": 1,
  "cases": [
    {
      "name": "scalar-zero-rows-yields-null",
      "source": "from Invoice as i\nselect (\n  i.InvoiceId\n  Name as (\n    from Customer as c\n    where c.CustomerId = i.CustomerId\n    select c.Name\n  )\n)",
      "context": {
        "authorizedSchemas": [
          {
            "version": "s1",
            "tables": [
              {
                "name": "Invoice",
                "fields": [
                  {
                    "name": "InvoiceId",
                    "type": "integer",
                    "authorized": true
                  },
                  {
                    "name": "CustomerId",
                    "type": "integer",
                    "authorized": true
                  }
                ]
              },
              {
                "name": "Customer",
                "fields": [
                  {
                    "name": "CustomerId",
                    "type": "integer",
                    "authorized": true
                  },
                  {
                    "name": "Name",
                    "type": "string",
                    "authorized": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "input": {
        "tables": {
          "Invoice": [
            {
              "InvoiceId": 1,
              "CustomerId": 10
            }
          ],
          "Customer": []
        }
      },
      "expected": {
        "records": [
          {
            "InvoiceId": 1,
            "Name": null
          }
        ]
      }
    },
